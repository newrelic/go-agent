  {
    "testDescription": "OpenTelemetry API can add a link to a span that starts a transaction",

    "operations": [
      {
        "command": "DoWorkInSpanWithRemoteParent",
        "parameters": {
          "spanName": "Foo",
          "spanKind": "Server"
        },
        "childOperations": [
          {
            "command": "AddLinkOnOTelSpan",
            "parameters": {
              "linkedTraceId": "0af7651916cd43dd8448eb211c80319c",
              "linkedSpanId": "b7ad6b7169203331"
            }
          }
        ]
      }
