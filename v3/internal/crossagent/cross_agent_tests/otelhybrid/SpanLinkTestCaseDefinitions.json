[
  {
    "testDescription": "OpenTelemetry API can add a link to a span within a transaction",

    "operations": [
      {
        "command": "DoWorkInTransaction",
        "parameters": {
          "transactionName": "Foo"
        },
        "childOperations": [
          {
            "command": "DoWorkInSpan",
            "parameters": {
              "spanName": "Bar",
              "spanKind": "Internal"
            },
            "childOperations": [
              {
                "command": "AddLinkOnOTelSpan",
                "parameters": {
                  "linkedTraceId": "0af7651916cd43dd8448eb211c80319c",
                  "linkedSpanId": "b7ad6b7169203331"
                }
              }
            ]
          }
        ]
      }
    ],

    "agentOutput": {
      "transactions": [
        {
          "name": "Foo"
        }
      ],
      "spans": [
        {
          "name": "Bar",
          "category": "generic",
          "parentName": "Foo",
          "links": [
            {
              "linkedTraceId": "0af7651916cd43dd8448eb211c80319c",
              "linkedSpanId": "b7ad6b7169203331"
            }
          ]
        },
        {
          "name": "Foo",
          "category": "generic",
          "entryPoint": true,
          "links": []
        }
      ]
    }
  },

