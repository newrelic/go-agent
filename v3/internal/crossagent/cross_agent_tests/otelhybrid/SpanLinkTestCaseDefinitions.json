  {
    "testDescription": "Links are not recorded for a span that is not recorded because there is no transaction",

    "operations": [
      {
        "command": "DoWorkInSpan",
        "parameters": {
          "spanName": "Bar",
          "spanKind": "Internal"
        },
        "childOperations": [
          {
            "command": "AddLinkOnOTelSpan",
            "parameters": {
              "linkedTraceId": "0af7651916cd43dd8448eb211c80319c",
              "linkedSpanId": "b7ad6b7169203331"
            }
          }
        ],
        "assertions": [
          {
            "description": "There should be no transaction",
            "rule": {
              "operator": "NotValid",
              "parameters": {
                "object": "currentTransaction"
              }
            }
          }
        ]
      }
    ],

    "agentOutput": {
      "transactions": [],
      "spans": []
    }
  },

  {
    "testDescription": "OpenTelemetry API can add an event to a span within a transaction",

    "operations": [
      {
        "command": "DoWorkInTransaction",
        "parameters": {
          "transactionName": "Foo"
        },
        "childOperations": [
          {
            "command": "DoWorkInSpan",
            "parameters": {
              "spanName": "Bar",
              "spanKind": "Internal"
            },
            "childOperations": [
              {
                "command": "AddEventOnOTelSpan",
                "parameters": {
                  "eventName": "MyEvent",
                  "attributes": {
                    "eventAttribute": "someValue"
                  }
                }
              }
            ]
          }
        ]
      }
    ],

    "agentOutput": {
      "transactions": [
        {
          "name": "Foo"
        }
      ],
      "spans": [
        {
          "name": "Bar",
          "category": "generic",
          "parentName": "Foo",
          "events": [
            {
              "name": "MyEvent",
              "attributes": {
                "eventAttribute": "someValue"
              }
            }
          ]
        },
        {
          "name": "Foo",
          "category": "generic",
          "entryPoint": true,
          "events": []
        }
      ]
    }
  },

